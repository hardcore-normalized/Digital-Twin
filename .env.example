# Copied to .env.local by `npm run setup` (runs automatically before `npm run dev`).

# Public URL of the app (used for auth callbacks).
BETTER_AUTH_URL=http://localhost:3000
# Random 32+ char secret for signing sessions.
BETTER_AUTH_SECRET=
# 32-byte base64 key used to encrypt customer API keys and storage credentials at rest.
ENCRYPTION_KEY=

# Database. Leave empty to use the built-in local database (PGlite, stored in .data/).
# In production, set a real Postgres URL, e.g. postgres://user:pass@host:5432/digital_twin
DATABASE_URL=

# Optional server-wide Anthropic key for self-hosting. Normally each zone brings its own key in Settings > AI.
ANTHROPIC_API_KEY=

# Allow local AI models and storage (localhost, LAN addresses, server folders).
# Leave unset to allow them in development only; set to true if you self-host,
# and keep it false on a server shared with people you don't trust.
ALLOW_LOCAL_ENDPOINTS=

# Automatic daily syncs run inside the server (each zone at its own time, default 2 PM).
# Set to true if you run several server instances or use serverless hosting, and call
# /api/cron/sync every 15 minutes instead.
DISABLE_SCHEDULER=

# Secret for the scheduled sync endpoint: GET /api/cron/sync with "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# ── Sign-in options ── each "Continue with …" button appears once its credentials are set.
# Redirect URL to register with each provider: <BETTER_AUTH_URL>/api/auth/callback/<provider>
#   e.g. http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# "common" (any work or personal Microsoft account) unless you set a tenant id.
MICROSOFT_TENANT_ID=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Company SSO: identity providers companies may connect, besides Microsoft Entra and Google
# (trusted by default). Comma-separated origins, e.g. https://acme.okta.com,https://acme.auth0.com
SSO_TRUSTED_ISSUERS=

# Email for verification links. Without SMTP_URL, links are printed to the server log.
# e.g. smtps://user:password@smtp.example.com:465
SMTP_URL=
EMAIL_FROM=
